generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String            @id @default(uuid())
  firebaseUid       String            @unique
  email             String            @unique
  username          String
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  score             Int               @default(0)
  answers           Answer[]
  quizRooms         QuizRoom[]        @relation("RoomCreator")
  participatedRooms RoomParticipant[]
}

model QuizTemplate {
  id         String                 @id @default(uuid())
  topic      String
  difficulty String                 @default("easy")
  createdAt  DateTime               @default(now())
  questions  QuizTemplateQuestion[]
}

model QuizTemplateQuestion {
  id            String       @id @default(uuid())
  templateId    String
  content       String
  options       Json
  correctOption Int
  explanation   String?
  createdAt     DateTime     @default(now())
  template      QuizTemplate @relation(fields: [templateId], references: [id])

  @@index([templateId])
}

model QuizRoom {
  id           String            @id @default(uuid())
  name         String
  topic        String
  difficulty   String            @default("easy")
  creatorId    String
  isActive     Boolean           @default(true)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  questions    Question[]
  creator      User              @relation("RoomCreator", fields: [creatorId], references: [id])
  participants RoomParticipant[]
}

model RoomParticipant {
  id       String   @id @default(uuid())
  userId   String
  roomId   String
  joinedAt DateTime @default(now())
  score    Int      @default(0)
  isActive Boolean  @default(true)
  room     QuizRoom @relation(fields: [roomId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  @@unique([userId, roomId])
}

model Question {
  id            String   @id @default(uuid())
  roomId        String
  content       String
  options       Json
  correctOption Int
  explanation   String?
  createdAt     DateTime @default(now())
  answers       Answer[]
  room          QuizRoom @relation(fields: [roomId], references: [id])
}

model Answer {
  id             String   @id @default(uuid())
  userId         String
  questionId     String
  selectedOption Int
  isCorrect      Boolean
  answeredAt     DateTime @default(now())
  question       Question @relation(fields: [questionId], references: [id])
  user           User     @relation(fields: [userId], references: [id])

  @@unique([userId, questionId])
}
